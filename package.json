{
  "name": "cs-pension-modeller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:acceptance && tsc && vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck:all && npm run test:coverage && npm run test:bdd && npm run build",
    "check:full": "npm run check && npm run test:e2e && npm run test:a11y && npm run test:smoke:prod && npm run audit",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:acceptance": "node scripts/generate-acceptance-docs.mjs",
    "lint": "npm run lint:eslint && npm run lint:knip",
    "lint:actions": "actionlint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:knip": "knip --dependencies --files",
    "lint:hook": "npm run lint",
    "preview": "vite preview",
    "prepare": "npm run setup:hooks",
    "prepublishOnly": "sh .githooks/pre-publish",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e": "playwright test e2e/app.spec.ts",
    "test:smoke:prod": "npm run build && playwright test e2e/production-smoke.spec.ts --config playwright.prod.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.typecheck.json --noEmit",
    "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js --config cucumber.mjs"
  },
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
